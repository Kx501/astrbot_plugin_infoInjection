{
  "schema_version": 1,
  "rules": [
    {
      "id": "wrap_user_msg",
      "enabled": true,
      "schedule": "always",
      "priority": 100,
      "when": {
        "chat": "any"
      },
      "inject": {
        "position": "message_replace",
        "template": "<msg user=\"{{user}}\" id=\"{{id}}\">{{content}}</msg>"
      }
    },
    {
      "id": "daily_date",
      "enabled": true,
      "schedule": "daily",
      "priority": 10,
      "when": {
        "chat": "any"
      },
      "inject": {
        "position": "system_end",
        "ephemeral": false,
        "template": "<dynamic_context>\n今日日期：{{date}}\n星期：{{weekday}}\n</dynamic_context>"
      }
    }
  ]
}
